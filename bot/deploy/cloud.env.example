# Copy only on the server to /etc/market-lab/cloud.env (root:marketlab 0640).
# No secret belongs in this example. Leave credentials empty until entered privately.
TRADING_MODE=DRY_RUN
TRADING_ENABLED=false
BOT_DB_PATH=/var/lib/market-lab/dry-run.sqlite
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_GATEWAY_MONITOR=false
IBKR_ALLOWED_ACCOUNT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_BOT_TOKEN=
# Alpaca is not used by this Swing deployment; do not copy its keys.
