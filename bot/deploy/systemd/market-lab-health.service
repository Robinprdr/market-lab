[Unit]
Description=Market Lab health diagnostic
After=market-lab-scheduler.service
[Service]
Type=oneshot
User=marketlab
Group=marketlab
WorkingDirectory=/opt/market-lab
EnvironmentFile=/etc/market-lab/cloud.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/market-lab
Restart=no
RestartSec=15
TimeoutStopSec=45
ExecStart=/opt/market-lab/.venv/bin/python -m bot.cloud_watch
